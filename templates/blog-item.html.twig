{% extends 'partials/base.html.twig' %}

{% block navigation %}
    <div id="navigation">
    {% if page.nextSibling %}
        <a class="nav nav-prev" href="{{ page.nextSibling.url }}"> <i class="fa fa-chevron-left"></i></a>
    {% endif %}

    {% if page.prevSibling %}
        <a class="nav nav-next" href="{{ page.prevSibling.url }}"><i class="fa fa-chevron-right"></i></a>
    {% endif %}
    </div>
{% endblock %}

{% block content %}
    <div id="body-inner">
        <article class="blog-post">
            <header>
                <h1>{{ page.title }}</h1>

                <div class="post-meta">
                    {% if page.header.author %}
                    <span class="author">
                        <i class="fa fa-user"></i> {{ page.header.author }}
                    </span>
                    {% endif %}

                    {% if page.date %}
                    <span class="date">
                        <i class="fa fa-calendar"></i> {{ page.date|date(config.system.pages.dateformat.short) }}
                    </span>
                    {% endif %}

                    {% if page.taxonomy.tag %}
                    <span class="tags">
                        <i class="fa fa-tags"></i>
                        {% for tag in page.taxonomy.tag %}
                            <a href="{{ base_url }}/tag:{{ tag }}">{{ tag }}</a>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </span>
                    {% endif %}

                    {% if page.taxonomy.category %}
                    <span class="categories">
                        <i class="fa fa-folder"></i>
                        {% for category in page.taxonomy.category %}
                            <a href="{{ base_url }}/category:{{ category }}">{{ category }}</a>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </span>
                    {% endif %}
                </div>
            </header>

            {% if page.header.featured_image %}
            <div class="featured-image">
                <img src="{{ page.media[page.header.featured_image].url }}" alt="{{ page.title }}">
            </div>
            {% endif %}

            <div class="post-content">
                {{ page.content|raw }}
            </div>
            
            {% if config.plugins.comments.enabled %}
                {{ page.commentsbox()|raw }}
            {% endif %}
        </article>
    </div>
{% endblock %}

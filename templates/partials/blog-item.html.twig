{% set blog_image = page.media.images|first %}
{% if page.header.featured_image and page.media[page.header.featured_image] %}
    {% set blog_image = page.media[page.header.featured_image] %}
{% endif %}

<div class="blog-list-item">
    <article>
        {% if blog_image %}
        <div class="list-blog-image">
            <a href="{{ page.url }}">
                {{ blog_image.cropZoom(400, 200).html(page.title, page.title, 'blog-image') }}
            </a>
        </div>
        {% endif %}
        
        <div class="list-blog-content">
            <header>
                <h2><a href="{{ page.url }}">{{ page.title }}</a></h2>
                
                <div class="list-blog-meta">
                    {% if page.header.author %}
                    <span class="author">
                        <i class="fa fa-user"></i> {{ page.header.author }}
                    </span>
                    {% endif %}
                    
                    {% if page.date %}
                    <span class="date">
                        <i class="fa fa-calendar"></i> {{ page.date|date(config.system.pages.dateformat.short) }}
                    </span>
                    {% endif %}
                    
                    {% if page.taxonomy.tag %}
                    <span class="tags">
                        <i class="fa fa-tags"></i>
                        {% for tag in page.taxonomy.tag %}
                            <a href="{{ base_url }}/tag:{{ tag }}">{{ tag }}</a>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </span>
                    {% endif %}
                </div>
            </header>
            
            <div class="list-blog-summary">
                {% if page.summary != page.content %}
                    {{ page.summary|raw }}
                {% else %}
                    {{ page.content|truncate(500)|raw }}
                {% endif %}
            </div>
            
            <footer>
                <a href="{{ page.url }}" class="button">{{ 'BLOG.READ_MORE'|t }}</a>
            </footer>
        </div>
    </article>
</div>
